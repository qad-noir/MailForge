APP_ENV=development
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/lead_sender
ADMIN_API_TOKEN=replace-with-a-long-random-token
UNSUBSCRIBE_SIGNING_SECRET=replace-with-a-separate-long-random-secret
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=updates@example.com
SENDGRID_FROM_NAME=Company Name
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_UNSUBSCRIBE_GROUP_ID=
WEBHOOK_SIGNATURE_REQUIRED=true
WORKER_STALE_TIMEOUT_SECONDS=300
MAX_SEND_ATTEMPTS=5
DEFAULT_SEND_RATE_PER_HOUR=1000
MAX_CSV_BYTES=10000000
MAX_CSV_ROWS=100000
MAX_METADATA_BYTES=8192

